[global]
monitor = 0
follow = mouse
width = 300
height = 100
origin = top-right
offset = 20x60
scale = 0
progress_bar = true
progress_bar_height = 10
progress_bar_frame_width = 1
progress_bar_min_width = 150
progress_bar_max_width = 200
indicate_hidden = yes
transparency = 0
separator_height = 2
padding = 12
horizontal_padding = 12
text_icon_padding = 0
frame_width = 2
sort = yes
idle_threshold = 120
font = Monospace 10
line_height = 4
markup = full
format = "<b>%s</b>\n%b"
alignment = left
vertical_alignment = center
show_age_threshold = 60
ellipsize = middle
ignore_newline = no
stack_duplicates = true
hide_duplicate_count = false
show_indicators = yes
icon_position = left
min_icon_size = 32
max_icon_size = 64
sticky_history = yes
history_length = 20
always_run_script = true
corner_radius = 8
ignore_dbusclose = false
force_xwayland = false
mouse_left_click = close_current
mouse_middle_click = do_action, close_current
mouse_right_click = close_all

[experimental]
per_monitor_dpi = no

[urgency_low]
background = "{background}cc"
foreground = "{foreground}"
frame_color = "{color8}"
timeout = 5

[urgency_normal]
background = "{background}cc"
foreground = "{foreground}"
frame_color = "{color3}"
timeout = 10

[urgency_critical]
background = "{color1}cc"
foreground = "{background}"
frame_color = "{color1}"
timeout = 0
